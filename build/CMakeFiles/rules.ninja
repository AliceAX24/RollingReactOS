#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /usr/bin/cmake --regenerate-during-build -S/home/alice/Estudos/ReactOS/ReactOSRCCompile1 -B/home/alice/Estudos/ReactOS/ReactOSRCCompile1/build
  description = Re-running CMake...
