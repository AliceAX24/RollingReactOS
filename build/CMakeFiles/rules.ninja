#############################################
# Rule for linking C shared module.

rule C_MODULE_LIBRARY_LINKER__winsrv_Debug
  command = $PRE_LINK && /usr/bin/i686-w64-mingw32-gcc -Wl,--start-group  $LINK_FLAGS -o $TARGET_FILE $in $LINK_PATH $LINK_LIBRARIES -Wl,--end-group && /home/alice/Estudos/ReactOS/ReactOSRCCompile1/build/host-tools/bin/rsym -s /home/alice/Estudos/ReactOS/ReactOSRCCompile1 $TARGET_FILE $TARGET_FILE && $POST_BUILD
  description = Linking C shared module $TARGET_FILE
  restat = $RESTAT


#############################################
# Rule for compiling C files.

rule C_COMPILER__concfg_unscanned_Debug
  depfile = $DEP_FILE
  deps = gcc
  command = ${LAUNCHER}${CODE_CHECK}/usr/bin/i686-w64-mingw32-gcc $DEFINES  $INCLUDES $FLAGS -MD -MT $out -MF $DEP_FILE -o $out -c $in
  description = Building C object $out


#############################################
# Rule for linking C static library.

rule C_STATIC_LIBRARY_LINKER__concfg_Debug
  command = $PRE_LINK && /usr/bin/i686-w64-mingw32-ar crT $TARGET_FILE $LINK_FLAGS $in && $POST_BUILD
  description = Linking C static library $TARGET_FILE
  restat = $RESTAT


#############################################
# Rule for compiling ASM files.

rule ASM_COMPILER__win32u_unscanned_Debug
  depfile = $DEP_FILE
  deps = gcc
  command = ${LAUNCHER}${CODE_CHECK}/usr/bin/i686-w64-mingw32-gcc  -x assembler-with-cpp -o $out -I/home/alice/Estudos/ReactOS/ReactOSRCCompile1/sdk/include/asm -I/home/alice/Estudos/ReactOS/ReactOSRCCompile1/build/sdk/include/asm $INCLUDES $FLAGS -MD -MT $out -MF $DEP_FILE $DEFINES -D__ASM__ -c $in
  description = Building ASM object $out


#############################################
# Rule for compiling C files.

rule C_COMPILER__win32u_unscanned_Debug
  depfile = $DEP_FILE
  deps = gcc
  command = ${LAUNCHER}${CODE_CHECK}/usr/bin/i686-w64-mingw32-gcc $DEFINES  $INCLUDES $FLAGS -MD -MT $out -MF $DEP_FILE -o $out -c $in
  description = Building C object $out


#############################################
# Rule for linking C shared module.

rule C_MODULE_LIBRARY_LINKER__win32u_Debug
  command = $PRE_LINK && /usr/bin/i686-w64-mingw32-gcc -Wl,--start-group  $LINK_FLAGS -o $TARGET_FILE $in $LINK_PATH $LINK_LIBRARIES -Wl,--end-group && /home/alice/Estudos/ReactOS/ReactOSRCCompile1/build/host-tools/bin/rsym -s /home/alice/Estudos/ReactOS/ReactOSRCCompile1 $TARGET_FILE $TARGET_FILE && $POST_BUILD
  description = Linking C shared module $TARGET_FILE
